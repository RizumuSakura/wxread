# Python 脚本不自动加载此文件；可由终端、平台或 Docker Compose 传入变量。
# 推荐先运行 python qr_login.py。默认登录文件无需额外配置。

# GitHub Actions：由扫码工具同步到 Secret，本地通常留空
WXREAD_LOGIN_JSON=

# 仅兼容旧版抓包配置，扫码用户留空
WXREAD_CURL_BASH=

# 本地状态路径（不指定时使用项目 .state 目录）
WXREAD_LOGIN_FILE=.state/login.enc
WXREAD_COOKIE_FILE=.state/cookies.enc

# 单次运行的目标成功请求次数（不是分钟 / 书籍 / 页数），只接受正整数
# 每次成功后等待 30 秒：40 约 20 分钟，120 约 60 分钟，240 约 120 分钟
# 总耗时还包含安装、网络、续期和重试；不保证服务端按此时长计入
# 不设置或留空默认 40；0 不能用来关闭任务；--check-auth 不运行阅读循环
# GitHub Actions 请设置 Repository Variables 中的 READ_NUM，而不是同名 Secret
READ_NUM=40

# 可选推送：pushplus / wxpusher / telegram / serverchan；留空不推送
PUSH_METHOD=
PUSHPLUS_TOKEN=
WXPUSHER_SPT=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SERVERCHAN_SPT=

# Docker 调度；GitHub Actions 的时间在 workflow 的 schedule 中设置
TZ=Asia/Shanghai
CRON_SCHEDULE=0 1 * * *
