# 配置参考：主流程全部在 GitHub Actions 执行，不提供本地扫码入口。
# Python 不会自动读取此文件；Compose 仅转发 docker-compose.yml 声明的变量。

# GitHub AutoRead Environment Secret：至少 20 位随机口令，勿提交实际值
# 用于加密二维码附件和云端登录状态；改变它后需重新扫码
WXREAD_QR_PASSWORD=

# GitHub AutoRead Secret：官方 Skill API Key，用于默认书架循环
WEREAD_API_KEY=

# 兼容既有凭据；完成云端扫码后，可在验证通过后移除旧 Secret
WXREAD_LOGIN_JSON=
WXREAD_CURL_BASH=

# 可选固定书籍：不设置时循环个人书架，支持阅读器链接或数字 bookId
# 例如《被讨厌的勇气》填 25615385；手动运行 book_url 可覆盖本次
WXREAD_BOOK_URL=

# 单轮总周期数（1–600），书架模式也是合计数量，不是每本的数量
# 先等待约 30 秒，再提交该段：40 约 20 分钟，120 约 60 分钟
# 失败、修复和网络会增加耗时；不保证服务端认可相同阅读时长
# GitHub 使用 Repository Variable READ_NUM，可被手动运行的 read_num 覆盖
READ_NUM=40

# 可选推送 Secrets；只选一种，留空不推送
PUSH_METHOD=
PUSHPLUS_TOKEN=
WXPUSHER_SPT=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SERVERCHAN_SPT=

# 高级兼容部署：已持有凭据时运行 main.py / Docker（不是扫码入口）
WXREAD_LOGIN_FILE=.state/login.enc
WXREAD_COOKIE_FILE=.state/cookies.enc
WXREAD_REPOSITORY=RizumuSakura/wxread
TZ=Asia/Shanghai
CRON_SCHEDULE=0 1 * * *
